#pragma kernel BlendDensities

RWStructuredBuffer<float4> points;  // Current chunk's points
StructuredBuffer<float4> neighborPoints0;
StructuredBuffer<float4> neighborPoints1;
StructuredBuffer<float4> neighborPoints2;
StructuredBuffer<float4> neighborPoints3;
StructuredBuffer<float4> neighborPoints4;
StructuredBuffer<float4> neighborPoints5;
StructuredBuffer<float4> neighborPoints6;
StructuredBuffer<float4> neighborPoints7;
StructuredBuffer<float4> neighborPoints8;
StructuredBuffer<float4> neighborPoints9;
StructuredBuffer<float4> neighborPoints10;
StructuredBuffer<float4> neighborPoints11;
StructuredBuffer<float4> neighborPoints12;
StructuredBuffer<float4> neighborPoints13;
StructuredBuffer<float4> neighborPoints14;
StructuredBuffer<float4> neighborPoints15;
StructuredBuffer<float4> neighborPoints16;
StructuredBuffer<float4> neighborPoints17;
StructuredBuffer<float4> neighborPoints18;
StructuredBuffer<float4> neighborPoints19;
StructuredBuffer<float4> neighborPoints20;
StructuredBuffer<float4> neighborPoints21;
StructuredBuffer<float4> neighborPoints22;
StructuredBuffer<float4> neighborPoints23;
StructuredBuffer<float4> neighborPoints24;
StructuredBuffer<float4> neighborPoints25;
StructuredBuffer<int> hasNeighbor;
float blendStrength;
int numPointsPerAxis;

int indexFromCoord(int x, int y, int z) {
    return z * numPointsPerAxis * numPointsPerAxis + y * numPointsPerAxis + x;
}

float4 GetNeighborPoint(int neighborIndex, int pointIndex) {
    switch(neighborIndex) {
        case 0: return neighborPoints0[pointIndex];
        case 1: return neighborPoints1[pointIndex];
        case 2: return neighborPoints2[pointIndex];
        case 3: return neighborPoints3[pointIndex];
        case 4: return neighborPoints4[pointIndex];
        case 5: return neighborPoints5[pointIndex];
        case 6: return neighborPoints6[pointIndex];
        case 7: return neighborPoints7[pointIndex];
        case 8: return neighborPoints8[pointIndex];
        case 9: return neighborPoints9[pointIndex];
        case 10: return neighborPoints10[pointIndex];
        case 11: return neighborPoints11[pointIndex];
        case 12: return neighborPoints12[pointIndex];
        case 13: return neighborPoints13[pointIndex];
        case 14: return neighborPoints14[pointIndex];
        case 15: return neighborPoints15[pointIndex];
        case 16: return neighborPoints16[pointIndex];
        case 17: return neighborPoints17[pointIndex];
        case 18: return neighborPoints18[pointIndex];
        case 19: return neighborPoints19[pointIndex];
        case 20: return neighborPoints20[pointIndex];
        case 21: return neighborPoints21[pointIndex];
        case 22: return neighborPoints22[pointIndex];
        case 23: return neighborPoints23[pointIndex];
        case 24: return neighborPoints24[pointIndex];
        case 25: return neighborPoints25[pointIndex];
        default: return float4(0,0,0,0);
    }
}

bool IsEdgePoint(int3 id) {
    return id.x == 0 || id.x == numPointsPerAxis - 1 ||
           id.y == 0 || id.y == numPointsPerAxis - 1 ||
           id.z == 0 || id.z == numPointsPerAxis - 1;
}

[numthreads(8, 8, 8)]
void BlendDensities(int3 id : SV_DispatchThreadID)
{
    if (id.x >= numPointsPerAxis || id.y >= numPointsPerAxis || id.z >= numPointsPerAxis) {
        return;
    }

    // Only process edge points
    if (!IsEdgePoint(id)) {
        return;
    }

    int index = indexFromCoord(id.x, id.y, id.z);
    float4 currentPoint = points[index];
    
    // Determine which neighbors to check based on position
    float totalValue = currentPoint.w;
    int count = 1;

    [unroll]
    for (int i = 0; i < 26; i++) {
        if (hasNeighbor[i] == 1) {
            float4 neighborPoint = GetNeighborPoint(i, index);
            
            // Force strong blending at edges
            if (IsEdgePoint(id)) {
                totalValue += neighborPoint.w;
                count++;
            }
        }
    }

    // Direct averaging at edges
    points[index] = float4(currentPoint.xyz, totalValue / count);
}
