// MeshBlend.compute
#pragma kernel BlendMesh

struct Vertex {
    float3 position;
};

RWStructuredBuffer<Vertex> vertices;
StructuredBuffer<Vertex> neighborVertex;
StructuredBuffer<int> neighborVertexCounts;
StructuredBuffer<int> neighborOffsets;
StructuredBuffer<int> hasNeighbor;
int numVertices;
float blendStrength;
float chunkSize;

[numthreads(64, 1, 1)]
void BlendMesh(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numVertices) return;
    
    Vertex vert = vertices[id.x];
    
    float3 normalizedPos = vert.position / chunkSize + 0.5;
    float3 distFromBoundary = min(normalizedPos, 1 - normalizedPos);
    float boundaryDist = min(min(distFromBoundary.x, distFromBoundary.y), distFromBoundary.z);
    
    if (boundaryDist > 0.1) return;
    
    float3 blendedPosition = vert.position;
    float totalWeight = 1;
    
    for (int i = 0; i < 26; i++)
    {
        if (hasNeighbor[i] == 1)
        {
            int startIdx = neighborOffsets[i];
            int count = neighborVertexCounts[i];
            
            float minDist = 999999;
            float3 nearestPos = vert.position;
            
            for (int j = 0; j < count; j++)
            {
                float3 neighborPos = neighborVertex[startIdx + j].position;
                float dist = distance(vert.position, neighborPos);
                if (dist < minDist)
                {
                    minDist = dist;
                    nearestPos = neighborPos;
                }
            }
            
            float weight = (1 - boundaryDist * 10) * blendStrength;
            blendedPosition = lerp(blendedPosition, nearestPos, weight);
            totalWeight += weight;
        }
    }
    
    vertices[id.x].position = blendedPosition / totalWeight;
}